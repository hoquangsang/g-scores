{
  "name": "@repo/web",
  "version": "0.0.0",
  "private": true,
  "description": "G-Scores Next.js frontend",
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3001",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "echo \"No unit tests yet\"",
    "clean": "node -e \"const fs=require('node:fs'); for (const p of ['.next','out','dist','.eslintcache']) fs.rmSync(p,{recursive:true,force:true});\""
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^6.0.2"
  }
}
