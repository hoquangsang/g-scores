{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "description": "G-Scores NestJS API",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "jest --config jest.config.mjs --testMatch \"**/test/**/*.unit.spec.ts\" --passWithNoTests",
    "test:int": "dotenv -e ../../.env.test -- node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.mjs --testMatch \"**/test/**/*.int-spec.ts\" --runInBand --testTimeout 30000 --passWithNoTests",
    "test:e2e": "dotenv -e ../../.env.test -- jest --config jest.config.mjs --testMatch \"**/test/**/*.e2e-spec.ts\" --passWithNoTests",
    "test:cov": "jest --config jest.config.mjs --testMatch \"**/test/**/*.unit.spec.ts\" --coverage --passWithNoTests",
    "test:cov:int": "dotenv -e ../../.env.test -- node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.mjs --testMatch \"**/test/**/*.int-spec.ts\" --runInBand --testTimeout 30000 --coverage --passWithNoTests",
    "openapi:generate": "nest build && tsc-alias -p tsconfig.build.json && tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.1",
    "@repo/cache": "workspace:*",
    "@repo/database": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.26",
    "@repo/jest-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.3.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.22.4",
    "typescript": "^6.0.2"
  }
}
