          "Catalogs"
        ]
      }
    },
    "/api/v1/scores/{registrationNumber}": {
      "get": {
        "operationId": "ScoresController_getCandidateScore_v1",
        "parameters": [
          {
            "name": "registrationNumber",
            "required": true,
            "in": "path",
            "schema": {
              "example": "01000001",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Candidate score detail",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessResponse"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/CandidateScoreResponseDto"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "tags": [
          "Scores"
        ]
      }
    },
    "/api/v1/reports/summary": {
      "get": {
        "operationId": "ReportsController_getReportSummary_v1",
        "parameters": [],
