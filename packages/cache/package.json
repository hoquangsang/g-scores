{
  "name": "@repo/cache",
  "version": "0.0.0",
  "private": true,
  "description": "G-Scores cache package",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -b --force",
    "typecheck": "tsc -b --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --config vitest.unit.config.ts --passWithNoTests",
    "test:int": "dotenv -e ../../.env.test -- vitest run --config vitest.int.config.ts --passWithNoTests",
    "test:cov": "vitest run --config vitest.unit.config.ts --coverage --passWithNoTests",
    "test:cov:int": "dotenv -e ../../.env.test -- vitest run --config vitest.int.config.ts --coverage --passWithNoTests"
  },
  "dependencies": {
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^6.0.2",
    "vitest": "^3.2.4"
  }
}
