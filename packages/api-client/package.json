{
  "name": "@repo/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed API client for G-Scores",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "pnpm generate && tsc -b",
    "generate": "pnpm generate:types",
    "generate:openapi": "pnpm --filter @repo/api openapi:generate",
    "generate:types": "openapi-typescript ../../apps/api/generated/openapi/schema.json -o src/generated/openapi/types.ts",
    "typecheck": "pnpm generate && tsc -b --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --config vitest.unit.config.ts --passWithNoTests",
    "test:int": "vitest run --config vitest.int.config.ts --passWithNoTests",
    "test:cov": "vitest run --config vitest.unit.config.ts --coverage --passWithNoTests",
    "test:cov:int": "vitest run --config vitest.int.config.ts --coverage --passWithNoTests"
  },
  "dependencies": {
    "openapi-fetch": "^0.15.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^3.2.6",
    "openapi-typescript": "^7.10.1",
    "typescript": "^6.0.2",
    "vitest": "^3.2.4"
  }
}
