generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ExamTrack {
  NATURAL
  SOCIAL
  UNKNOWN
}

model Candidate {
  id                 String    @id @default(uuid())
  registrationNumber String
  examTrack          ExamTrack @default(UNKNOWN)
  foreignLanguageId  String?

  foreignLanguage ForeignLanguage? @relation(fields: [foreignLanguageId], references: [id])
  scores          CandidateScore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([registrationNumber])
  @@index([examTrack])
}

model Subject {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores     CandidateScore[]
  examGroups ExamGroupSubject[]
}

model CandidateScore {
  candidateId String
  subjectId   String
  score       Decimal @db.Decimal(4, 2)

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([candidateId, subjectId])
  @@index([subjectId, score])
}

model ForeignLanguage {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidates Candidate[]
}

model ExamGroup {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects ExamGroupSubject[]
}

model ExamGroupSubject {
  examGroupId String
  subjectId   String

  examGroup ExamGroup @relation(fields: [examGroupId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([examGroupId, subjectId])
  @@index([subjectId])
}
