{
  "name": "@repo/database",
  "version": "0.0.0",
  "private": true,
  "description": "G-Scores Prisma database package",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "pnpm db:generate && tsc -b --force",
    "dev": "tsc -b --watch",
    "typecheck": "tsc -b --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "typescript": "^6.0.2"
  },
  "prisma": {
    "seed": "node dist/seed.js"
  }
}
