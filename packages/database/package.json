{
  "name": "@repo/database",
  "version": "0.0.0",
  "private": true,
  "description": "G-Scores Prisma database package",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "pnpm db:generate && tsc -b --force",
    "dev": "tsc -b --watch",
    "typecheck": "tsc -b --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --exclude \"test/**/*.int.spec.ts\" --passWithNoTests",
    "test:int": "vitest run --exclude \"test/**/*.unit.spec.ts\" --passWithNoTests",
    "test:cov": "vitest run --exclude \"test/**/*.int.spec.ts\" --coverage --passWithNoTests"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "pg": "^8.16.3",
    "prisma": "^7.8.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/pg": "^8.16.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
