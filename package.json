{
  "name": "@repo/root",
  "version": "0.0.0",
  "private": true,
  "description": "G-Scores fullstack assignment",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location .eslintcache",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:unit",
    "test:unit": "turbo run test:unit",
    "test:int": "dotenv -e .env.test -- turbo run test:int",
    "test:e2e": "dotenv -e .env.test -- turbo run test:e2e",
    "test:cov": "turbo run test:cov",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "docker:build": "docker compose --env-file infrastructure/docker/.env -f infrastructure/docker/compose.local.yml build",
    "docker:up": "docker compose --env-file infrastructure/docker/.env -f infrastructure/docker/compose.local.yml up -d",
    "docker:down": "docker compose --env-file infrastructure/docker/.env -f infrastructure/docker/compose.local.yml down",
    "docker:logs": "docker compose --env-file infrastructure/docker/.env -f infrastructure/docker/compose.local.yml logs -f",
    "db:generate": "pnpm --filter @repo/database db:generate",
    "db:migrate": "pnpm --filter @repo/database db:migrate",
    "db:deploy": "pnpm --filter @repo/database db:deploy",
    "db:reset": "pnpm --filter @repo/database db:reset",
    "db:seed": "pnpm --filter @repo/database db:seed",
    "db:studio": "pnpm --filter @repo/database db:studio",
    "db:test:deploy": "dotenv -e .env.test -- pnpm --filter @repo/database db:deploy",
    "db:test:reset": "dotenv -e .env.test -- pnpm --filter @repo/database db:reset",
    "db:test:seed": "dotenv -e .env.test -- pnpm --filter @repo/database db:seed",
    "data:import:scores": "pnpm --filter @repo/data-import import:scores",
    "docker:test:up": "docker compose -f infrastructure/docker/compose.test.yml up -d",
    "docker:test:down": "docker compose -f infrastructure/docker/compose.test.yml down",
    "docker:test:logs": "docker compose -f infrastructure/docker/compose.test.yml logs -f",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "dotenv-cli": "^11.0.0",
    "@types/node": "^25.6.0",
    "eslint": "^9.39.4",
    "lefthook": "^1.13.6",
    "prettier": "^3.8.3",
    "turbo": "^2.9.6",
    "typescript": "^6.0.2"
  },
  "packageManager": "pnpm@10.33.0"
}
